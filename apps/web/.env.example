# ATENCAO: tudo com prefixo VITE_ e embutido no bundle e fica VISIVEL para
# qualquer pessoa que abrir o site. Nunca coloque segredo aqui.

# Endereco da API do Compoze. Use "demo" para rodar o app inteiro sem backend,
# com dados de exemplo guardados no navegador (ver docs/decisoes/0003-modo-demo.md).
VITE_API_URL=demo
# API local (pnpm dev:api na raiz):
# VITE_API_URL=http://localhost:3333
