# Copie para .env. O banco local sobe com `pnpm db:up` na raiz.
DATABASE_URL=postgres://compoze:compoze@localhost:5432/compoze
PORT=3333
# Origens do front aceitas pelo CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Assina os tokens de acesso. Qualquer texto aleatório com 32+ caracteres.
JWT_SECRET=troque-por-um-texto-aleatorio-de-32-caracteres-ou-mais
LOG_LEVEL=info
